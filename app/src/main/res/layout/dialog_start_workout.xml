<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="?attr/colorSurface">

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/logo"
        android:scaleType="fitCenter"
        android:layout_marginBottom="16dp"
        android:contentDescription="RepSync Logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start a Session"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="Use a template as a starting point, or create a new routine template."
        android:textColor="?attr/colorTextSecondary"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSavedWorkout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="Use Routine Template"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_workouts"
        app:iconSize="20dp"
        app:iconPadding="12dp"
        app:cornerRadius="16dp"
        android:layout_marginBottom="12dp"
        app:backgroundTint="?attr/colorPrimary"
        android:alpha="0.85" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCreateNew"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="Create Routine Template"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        app:icon="@android:drawable/ic_input_add"
        app:iconSize="20dp"
        app:iconPadding="12dp"
        app:iconTint="?attr/colorPrimary"
        app:cornerRadius="16dp"
        app:strokeColor="?attr/colorPrimary"
        app:strokeWidth="1.5dp"
        android:textColor="?attr/colorPrimary" />

</LinearLayout>
