<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="204dp"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorDivider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/ivTrophyIcon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/gym_rat_locked" />

        <TextView
            android:id="@+id/tvTrophyName"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center"
            android:maxLines="2"
            android:text="Gym Rat"
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTrophyRank"
            android:layout_width="match_parent"
            android:layout_height="13dp"
            android:gravity="center"
            android:text="Bronze"
            android:textAllCaps="true"
            android:textSize="10sp"
            android:textStyle="bold" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/trophyProgressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            app:trackCornerRadius="4dp"
            app:trackThickness="5dp" />

        <TextView
            android:id="@+id/tvTrophyProgressText"
            android:layout_width="match_parent"
            android:layout_height="13dp"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="10 / 50"
            android:textColor="?attr/colorTextSecondary"
            android:textSize="9sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPinTrophy"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="Pin"
            android:textAllCaps="false"
            android:textSize="11sp" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
