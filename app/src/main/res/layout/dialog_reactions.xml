<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_reaction_dialog"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Add your reaction buttons (ImageButtons/TextViews) here -->

    <TextView
        android:id="@+id/emojiFire"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="🔥"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/emojiSquat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="🏋️‍♂️"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/emojiTrophy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="30sp"
        android:text="🏆"
        android:padding="8dp"/>

    <TextView
        android:id="@+id/emojiArm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="💪️"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/emojiMedal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="30sp"
        android:text="🥇"
        android:padding="8dp"/>

</LinearLayout>